# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Never commit .env.local, and never put
# the service_role key in a NEXT_PUBLIC_ variable or ship it to the browser —
# this app never needs it; every privileged operation is a Postgres function
# guarded by auth.uid() checks + Row Level Security, callable safely with
# just the anon key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
